[Unit]
Description=Mining lab gate orchestrator
Documentation=https://github.com/johnny9/mining-qa-lab/blob/main/docs/ORCHESTRATOR_DEPLOYMENT.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/mining-qa-lab/current
EnvironmentFile=-%h/.config/mining-qa-lab/orchestrator.env
ExecStartPre=/usr/bin/env %h/.local/opt/mining-qa-lab/current/.venv/bin/miner-orchestrator --config %h/.config/mining-qa-lab/orchestrator.yaml validate
ExecStart=/usr/bin/env %h/.local/opt/mining-qa-lab/current/.venv/bin/miner-orchestrator --config %h/.config/mining-qa-lab/orchestrator.yaml serve
Restart=on-failure
RestartSec=10s
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# ConfigStore atomically replaces YAML and writes a backup in this directory.
ReadWritePaths=-%h/.config/mining-qa-lab
# Do not let that directory allowance make the optional secret file writable.
ReadOnlyPaths=-%h/.config/mining-qa-lab/orchestrator.env
ReadWritePaths=-%h/.local/state/mining-qa-lab
ReadWritePaths=-%h/.local/state/mining-qa-testcode
ReadWritePaths=-%h/.local/lib/mining-qa-testcode
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SyslogIdentifier=miner-orchestrator

[Install]
WantedBy=default.target
