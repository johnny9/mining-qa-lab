#!/usr/bin/env python3
"""Validate repository-owned skills without changing installation state."""

from __future__ import annotations

import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
SKILLS_ROOT = REPO_ROOT / "skills"
NAME_PATTERN = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*\Z")
HOME_PATH_PATTERN = re.compile(r"(?:/home|/Users)/([^/\s'\"`]+)")
IPV4_PATTERN = re.compile(r"(?<![\d.])(?:\d{1,3}\.){3}\d{1,3}(?![\d.])")
MAC_PATTERN = re.compile(
    r"(?i)(?<![0-9a-f])(?:[0-9a-f]{2}:){5}[0-9a-f]{2}(?![0-9a-f])"
)
EMAIL_PATTERN = re.compile(
    r"(?i)\b[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9.-]+\.[a-z]{2,}\b"
)
MARKDOWN_LINK_PATTERN = re.compile(r"\[[^]]*\]\(([^)]+)\)")
ALLOWED_HOME_NAMES = {"user"}
ALLOWED_IPV4 = {"127.0.0.1", "0.0.0.0"}
TEXT_SUFFIXES = {"", ".md", ".py", ".service", ".sh", ".txt", ".yaml", ".yml"}


class ValidationError(Exception):
    pass


def parse_frontmatter(path: Path) -> dict[str, str]:
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0] != "---":
        raise ValidationError("SKILL.md must start with YAML frontmatter")
    try:
        end = lines.index("---", 1)
    except ValueError as exc:
        raise ValidationError("SKILL.md frontmatter is not closed") from exc
    metadata: dict[str, str] = {}
    for line in lines[1:end]:
        if not line.strip():
            continue
        if ":" not in line:
            raise ValidationError(f"invalid frontmatter line: {line!r}")
        key, value = line.split(":", 1)
        key = key.strip()
        value = value.strip().strip("\"'")
        if key in metadata:
            raise ValidationError(f"duplicate frontmatter key: {key}")
        metadata[key] = value
    if set(metadata) != {"name", "description"}:
        raise ValidationError("frontmatter must contain only name and description")
    if not metadata["description"]:
        raise ValidationError("description must not be empty")
    return metadata


def validate_agent_metadata(path: Path, skill_name: str) -> None:
    if not path.is_file():
        raise ValidationError("agents/openai.yaml is missing")
    text = path.read_text(encoding="utf-8")
    for key in ("display_name", "short_description", "default_prompt"):
        if not re.search(rf'^  {key}: ".+"$', text, re.MULTILINE):
            raise ValidationError(f"agents/openai.yaml has no quoted {key}")
    if f"${skill_name}" not in text:
        raise ValidationError("default_prompt must name the skill with $skill-name")


def validate_no_personal_data(path: Path) -> None:
    text = path.read_text(encoding="utf-8")
    findings: list[str] = []
    for match in HOME_PATH_PATTERN.finditer(text):
        if match.group(1) not in ALLOWED_HOME_NAMES:
            findings.append(f"personal home path {match.group(0)!r}")
    for match in IPV4_PATTERN.finditer(text):
        address = match.group(0)
        octets = [int(part) for part in address.split(".")]
        if all(part <= 255 for part in octets) and address not in ALLOWED_IPV4:
            findings.append(f"specific IPv4 address {address!r}")
    for match in MAC_PATTERN.finditer(text):
        findings.append(f"MAC address {match.group(0)!r}")
    for match in EMAIL_PATTERN.finditer(text):
        findings.append(f"email address {match.group(0)!r}")
    if findings:
        raise ValidationError("possible personal data: " + ", ".join(findings))


def validate_links(skill_dir: Path, path: Path) -> None:
    text = path.read_text(encoding="utf-8")
    for raw_target in MARKDOWN_LINK_PATTERN.findall(text):
        target = raw_target.strip().strip("<>").split("#", 1)[0]
        if not target or target.startswith(("http://", "https://", "mailto:")):
            continue
        resolved = (path.parent / target).resolve()
        try:
            resolved.relative_to(skill_dir.resolve())
        except ValueError as exc:
            raise ValidationError(f"link escapes skill directory: {raw_target}") from exc
        if not resolved.exists():
            raise ValidationError(f"unresolved link in {path.name}: {raw_target}")


def validate_skill(skill_dir: Path) -> None:
    skill_path = skill_dir / "SKILL.md"
    metadata = parse_frontmatter(skill_path)
    name = metadata["name"]
    if not NAME_PATTERN.fullmatch(name) or name != skill_dir.name:
        raise ValidationError(f"invalid or mismatched skill name: {name!r}")
    if len(skill_path.read_text(encoding="utf-8").splitlines()) >= 500:
        raise ValidationError("SKILL.md must stay below 500 lines")
    validate_agent_metadata(skill_dir / "agents" / "openai.yaml", name)

    for path in sorted(skill_dir.rglob("*")):
        if not path.is_file() or "__pycache__" in path.parts:
            continue
        if path.suffix in TEXT_SUFFIXES:
            validate_no_personal_data(path)
        if path.suffix == ".py":
            compile(path.read_text(encoding="utf-8"), str(path), "exec")
        if path.suffix == ".md":
            validate_links(skill_dir, path)


def main() -> int:
    skill_dirs = sorted(
        path for path in SKILLS_ROOT.iterdir() if path.is_dir() and not path.name.startswith(".")
    )
    if not skill_dirs:
        print("error: no skills found", file=sys.stderr)
        return 1
    failed = False
    for skill_dir in skill_dirs:
        try:
            validate_skill(skill_dir)
        except (OSError, UnicodeError, SyntaxError, ValidationError) as exc:
            failed = True
            print(f"FAIL {skill_dir.name}: {exc}", file=sys.stderr)
        else:
            print(f"OK   {skill_dir.name}")
    return int(failed)


if __name__ == "__main__":
    raise SystemExit(main())
