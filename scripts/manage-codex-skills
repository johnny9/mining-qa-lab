#!/usr/bin/env bash
set -euo pipefail

readonly SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"
readonly SKILLS_ROOT="$REPO_ROOT/skills"
readonly -a AVAILABLE_SKILLS=(
    manage-lab-orchestrator-deployment
)

usage() {
    cat <<'EOF'
Usage:
  scripts/manage-codex-skills list
  scripts/manage-codex-skills status [all|SKILL...]
  scripts/manage-codex-skills install all|SKILL...

Install creates repository-backed links under
${CODEX_HOME:-$HOME/.codex}/skills. Existing destinations are never replaced.
EOF
}

is_available() {
    local requested=$1
    local available
    for available in "${AVAILABLE_SKILLS[@]}"; do
        if [[ $requested == "$available" ]]; then
            return 0
        fi
    done
    return 1
}

select_skills() {
    if (($# == 0)) || [[ ${1:-} == all ]]; then
        if (($# > 1)); then
            echo "error: 'all' cannot be combined with skill names" >&2
            return 2
        fi
        SELECTED_SKILLS=("${AVAILABLE_SKILLS[@]}")
        return
    fi

    local requested
    SELECTED_SKILLS=()
    for requested in "$@"; do
        if ! is_available "$requested"; then
            echo "error: unknown skill: $requested" >&2
            echo "available skills: ${AVAILABLE_SKILLS[*]}" >&2
            return 2
        fi
        SELECTED_SKILLS+=("$requested")
    done
}

codex_skills_root() {
    local root
    if [[ -n ${CODEX_HOME:-} ]]; then
        root=$CODEX_HOME
    elif [[ -n ${HOME:-} ]]; then
        root=$HOME/.codex
    else
        echo "error: HOME is unset and CODEX_HOME is not configured" >&2
        return 2
    fi
    if [[ $root != /* ]]; then
        echo "error: agent home must be an absolute path: $root" >&2
        return 2
    fi
    printf '%s/skills\n' "$root"
}

link_matches_source() {
    local destination=$1
    local source=$2
    local resolved
    [[ -L $destination ]] || return 1
    resolved=$(readlink -f -- "$destination" 2>/dev/null || true)
    [[ $resolved == "$source" ]]
}

show_status() {
    local destination_root=$1
    shift
    local skill source destination
    local conflict=0
    for skill in "$@"; do
        source="$SKILLS_ROOT/$skill"
        destination="$destination_root/$skill"
        if link_matches_source "$destination" "$source"; then
            printf 'linked    %s -> %s\n' "$skill" "$source"
        elif [[ -L $destination ]]; then
            printf 'conflict  %s is a link to %s\n' "$skill" "$(readlink -- "$destination")"
            conflict=1
        elif [[ -e $destination ]]; then
            printf 'conflict  %s exists at %s and is not a link\n' "$skill" "$destination"
            printf '          compare: diff -ru -- %q %q\n' "$source" "$destination"
            conflict=1
        else
            printf 'missing   %s\n' "$skill"
        fi
    done
    return "$conflict"
}

install_skills() {
    local destination_root=$1
    shift
    mkdir -p -- "$destination_root"

    local skill source destination
    local conflict=0
    for skill in "$@"; do
        source="$SKILLS_ROOT/$skill"
        destination="$destination_root/$skill"
        if [[ ! -f $source/SKILL.md ]]; then
            echo "error: source skill is incomplete: $source" >&2
            return 2
        fi
        if link_matches_source "$destination" "$source"; then
            printf 'already linked: %s\n' "$skill"
        elif [[ -e $destination || -L $destination ]]; then
            echo "refusing to replace existing destination: $destination" >&2
            if [[ -d $destination && ! -L $destination ]]; then
                printf 'compare it first: diff -ru -- %q %q\n' "$source" "$destination" >&2
            fi
            conflict=1
        else
            ln -s -- "$source" "$destination"
            printf 'installed: %s -> %s\n' "$destination" "$source"
        fi
    done
    return "$conflict"
}

main() {
    local command=${1:-}
    if [[ -z $command ]]; then
        usage >&2
        return 2
    fi
    shift

    case "$command" in
        list)
            if (($# != 0)); then
                usage >&2
                return 2
            fi
            printf '%s\n' "${AVAILABLE_SKILLS[@]}"
            ;;
        status|install)
            if [[ $command == install && $# == 0 ]]; then
                echo "error: choose a skill or explicitly pass 'all'" >&2
                return 2
            fi
            select_skills "$@"
            local destination_root
            destination_root=$(codex_skills_root)
            if [[ $command == status ]]; then
                show_status "$destination_root" "${SELECTED_SKILLS[@]}"
            else
                install_skills "$destination_root" "${SELECTED_SKILLS[@]}"
            fi
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            echo "error: unknown command: $command" >&2
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
